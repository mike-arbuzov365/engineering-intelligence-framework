# Example EIF project-instance configuration.
# In practice you do NOT hand-write this - `scripts/eif_init.py` generates it
# with a real framework `ref` filled in. This example documents the shape.
# Machine-readable schema: ../core/schemas/eif-config.schema.json
# Instance/upgrade contract: ../docs/architecture/instance-contract.md
# See docs/architecture/HOW-EIF-WORKS.md for what's built vs. planned.

# This config file's OWN schema version - bump only when the config shape
# changes in a breaking way. Independent of the framework release below.
schema_version: 1

framework:
  # No versioned release exists yet - see
  # docs/architecture/HOW-EIF-WORKS.md#definition-of-public-ready. `ref` is
  # the ACTUAL framework commit this instance was generated from; eif_init
  # resolves it via `git rev-parse HEAD` and writes the real 40-char SHA
  # here (the placeholder below is only for this hand-written example). This
  # whole config is EXPERIMENTAL - the eventual package/submodule/installer
  # distribution model is an open decision, see core/policies/decisions.md D-08.
  version: "0.1.0-dev"
  source: "https://github.com/mike-arbuzov365/engineering-intelligence-framework"
  ref: "0000000000000000000000000000000000000000"  # example only; eif_init writes the real HEAD SHA
  ref_short: "0000000"
  bundle: .eif/runtime  # pinned self-contained runtime copied into the instance by eif_init

instance:
  # Provenance/upgrade contract - see docs/architecture/instance-contract.md.
  eif_instance_version: 0.1.0
  migration_status: greenfield  # greenfield (new repo) | adopted (pre-existing repo brought under EIF)

adapter:
  # Which agent adapter the generated entrypoint targets. claude-code ->
  # CLAUDE.md (the file Claude Code loads at session start).
  name: claude-code
  entrypoint: CLAUDE.md

project:
  name: example-project

localization:
  # BCP-47 language tags (en, uk, en-US, ...).
  # Locale for generated project documentation (ADRs, Knowledge Delta,
  # session context, playbook output).
  documentation_locale: en
  # Locale the agent writes prose responses in - falls back to
  # documentation_locale if unset.
  agent_response_locale: en
  fallback_locale: en
  # Framework identifiers, schema keys, code, and command examples stay
  # English regardless of documentation_locale - this flag documents that
  # intent, it does not (yet) enforce it.
  preserve_technical_terms: true
  code_comments_locale: en
  commit_messages_locale: en

governance:
  knowledge_delta_required: true
  evidence_labels_required: true
  # Explicit acknowledgment that any integration below may be absent or
  # unreachable. If false, a configured-but-unreachable integration should
  # hard-fail instead of silently degrading - see each integration's
  # failure_policy for the actual per-integration behavior.
  degraded_mode_allowed: true

privacy:
  # Never read, index, or export paths matching these globs, regardless of
  # what any integration or skill would otherwise do.
  deny_paths:
    - "**/.env*"
    - "**/*.secret"
    - "**/secrets/**"
  # Path to instance-specific deny patterns (private repo names, customer
  # names, machine paths, etc). This file is real, local, and MUST be
  # gitignored - never commit the actual file, only this pointer to it.
  # See scripts/README.md for the privacy scanner that reads it.
  local_denylist_file: ".eif/local-denylist.txt"

# Optional integrations - each defaults to disabled. EIF's core governance
# model works without any of them; see integrations/README.md for the
# degraded-mode behavior when disabled or unreachable.
integrations:
  structural_graph:
    enabled: false
    provider: null          # e.g. "graphify" - not validated against a real provider list yet
    processing: local       # local | external
    data_boundary: local-only   # local-only | external-api - must match the provider's actual behavior, not a wish
    cost_cap_usd: 0
    failure_policy: degrade # degrade | fail-closed
  shell_output_compression:
    enabled: false
    provider: null          # e.g. "rtk"
    processing: local
    data_boundary: local-only
    failure_policy: degrade
  vendor_docs:
    enabled: false
    provider: null          # e.g. "context7"
    processing: external    # queries leave the local machine
    data_boundary: external-api
    cost_cap_usd: 0
    failure_policy: degrade
