# Example EIF project-instance configuration - USER-OWNED.
# In practice you do NOT hand-write this - `scripts/eif_init.py` generates it.
# It is created once and never overwritten by a routine upgrade (only an
# explicit --force re-run replaces it, after backing it up).
#
# Framework PROVENANCE (exact commit, dirty flag, bundle file hashes,
# generated adapter entrypoint) does NOT live here - it lives in the
# separate, EIF-managed .eif/framework.lock.yaml, fully regenerated on every
# init/upgrade. See framework.lock.yaml.example alongside this file, and
# ../docs/architecture/instance-contract.md for why the two are split.
#
# Machine-readable schema: ../core/schemas/eif-config.schema.json
# See docs/architecture/HOW-EIF-WORKS.md for what's built vs. planned.

# This config file's OWN schema version - bump only when the config shape
# changes in a breaking way.
schema_version: 1

# Optional: a DESIRED framework release line - not provenance, just a hint.
# EXPERIMENTAL - the eventual package/submodule/installer distribution model
# is an open decision, see core/policies/decisions.md D-08.
framework:
  version: "0.1.0-dev"

project:
  name: example-project

adapter:
  # Which agent adapter the generated entrypoint targets. The generated
  # entrypoint FILE and its verified-version evidence are managed
  # provenance - see framework.lock.yaml, not here. claude-code -> CLAUDE.md
  # (the file Claude Code actually loads at session start).
  name: claude-code
  # Optional, adapter-specific settings (scripts/eif_adapters.py declares
  # which keys each adapter supports). Omit entirely for the adapter's own
  # documented defaults - most projects never need this. Example, for an
  # adopted repo whose Codex config.toml already customizes these keys:
  # options:
  #   codex:
  #     project_doc_fallback_filenames: ["TEAM_GUIDE.md"]
  #     project_doc_max_bytes: 65536
  #     project_root_markers: [".git", ".hg"]  # empty [] disables root detection (cwd-only)
  #   hermes:
  #     parent_context_action: override-with-local  # only if a parent .hermes.md/HERMES.md should be shadowed by a new local one
  #     context_file_max_chars: 65536  # EIF's own fallback default is the conservative 20000, not Hermes's dynamic model-scaled cap

localization:
  # BCP-47 language tags (en, uk, en-US, ...).
  # Locale for generated project documentation (Knowledge Delta, closeout,
  # status messages) - scripts/eif_render.py reads this by default.
  documentation_locale: en
  # Locale the agent writes prose responses in - falls back to
  # documentation_locale if unset.
  agent_response_locale: en
  fallback_locale: en
  # Framework identifiers, schema keys, code, and command examples stay
  # English regardless of documentation_locale - this flag documents that
  # intent, it does not (yet) enforce it.
  preserve_technical_terms: true
  code_comments_locale: en
  commit_messages_locale: en

governance:
  knowledge_delta_required: true
  evidence_labels_required: true
  # Explicit acknowledgment that any integration below may be absent or
  # unreachable. If false, a configured-but-unreachable integration should
  # hard-fail instead of silently degrading - see each integration's
  # failure_policy for the actual per-integration behavior.
  degraded_mode_allowed: true

knowledge:
  # Where knowledge artifacts live, instance-relative. Defaults shown here
  # are the greenfield defaults - an EXISTING repository being adopted can
  # point these at wherever knowledge already lives (e.g. docs/knowledge/)
  # instead of migrating content to match EIF's default layout. Generated
  # instructions and the index/search commands read these values - they do
  # not hardcode "knowledge" independently of this config.
  root: knowledge
  index_path: knowledge/index.md
  # Whether eif_init.py may generate/regenerate the index file at all.
  # Greenfield default: true. Coexist default: false (explicit opt-in via
  # --manage-knowledge-index required - a coexisting project may already
  # manage its own knowledge, and EIF must not start doing it unasked).
  # Even when true, an existing file at index_path WITHOUT EIF's own
  # generated-file marker is never overwritten (a hard refusal, not a
  # silent skip) - this only opts into EIF managing the index going
  # forward, it does not authorize taking over an existing project file.
  managed: true

adoption:
  # greenfield (default): the generated block may present itself as this
  # project's baseline authority. coexist: required when eif_init's
  # adoption preflight (scripts/eif_preflight.py) detects pre-existing
  # entrypoint content - the generated block will not declare itself sole
  # authority, will not override existing governance, and will say
  # explicitly that project-owned instructions outside the EIF markers
  # stay canonical. See
  # docs/architecture/instance-contract.md#adoption-existing-repositories.
  mode: greenfield

privacy:
  # Never read, index, or export paths matching these globs, regardless of
  # what any integration or skill would otherwise do.
  deny_paths:
    - "**/.env*"
    - "**/*.secret"
    - "**/secrets/**"
  # Path to instance-specific deny patterns (private repo names, customer
  # names, machine paths, etc). This file is real, local, and MUST be
  # gitignored - never commit the actual file, only this pointer to it.
  # See scripts/README.md for the privacy scanner that reads it.
  local_denylist_file: ".eif/local-denylist.txt"
  # Controlled exceptions to eif_privacy_scan.py findings - FINDING-
  # specific (rule + exact path + a content fingerprint), never a whole
  # rule+file. Never a way to weaken a detection pattern for everyone; a
  # suppression that stops matching (its fingerprinted line changed or is
  # gone), or whose expires date has passed, is itself reported as a
  # finding (suppression hygiene). Get the exact fingerprint from the
  # scanner's own output for the finding you are reviewing
  # (`python scripts/eif_privacy_scan.py --json`) - never guess it by
  # hand. Example:
  # suppressions:
  #   - rule: "secret_shaped:password_assignment"
  #     path: "src/types/keytar.d.ts"
  #     fingerprint: "a1b2c3d4e5f60718"
  #     rationale: >-
  #       TypeScript interface method signature for the keytar OS-keychain
  #       module (setPassword(...): Promise<void>) - a type declaration,
  #       not an assigned secret value.
  #     reviewed: "2026-07-15"
  #     expires: "2026-10-15"
  suppressions: []

# Optional integrations - each defaults to disabled. EIF's core governance
# model works without any of them; see integrations/README.md for the
# degraded-mode behavior when disabled or unreachable.
integrations:
  structural_graph:
    enabled: false
    provider: null          # e.g. "graphify" - not validated against a real provider list yet
    processing: local       # local | external
    data_boundary: local-only   # local-only | external-api - must match the provider's actual behavior, not a wish
    cost_cap_usd: 0
    failure_policy: degrade # degrade | fail-closed
  shell_output_compression:
    enabled: false
    provider: null          # e.g. "rtk"
    processing: local
    data_boundary: local-only
    failure_policy: degrade
  vendor_docs:
    enabled: false
    provider: null          # e.g. "context7"
    processing: external    # queries leave the local machine
    data_boundary: external-api
    cost_cap_usd: 0
    failure_policy: degrade
