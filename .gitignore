# OS cruft
Thumbs.db
Desktop.ini
.DS_Store
*~
*.tmp
*.bak
*.swp

# IDE
.vscode/
.idea/

# Local tool state (never a real config)
.claude/settings.local.json

# Secrets
.env
.env.local
*.secret

# Instance-specific privacy denylist - real content is local-only, never
# committed. See .eif/local-denylist.txt.example for the template. (A
# project instance's own .eif/config.yaml is normally fine to commit - it
# is not a secret by default - so it is not ignored here.)
.eif/local-denylist.txt

# EIF-managed per-instance runtime bundle - regenerated by eif_init on init/
# upgrade, never hand-edited, so never committed (a fresh clone materializes
# it by running eif_init). See scripts/eif_init.py.
**/.eif/runtime/

# eif_init non-destructive backups (config.yaml.bak-<timestamp>, etc.)
*.bak-*

# Generated/raw outputs
graphify-out/
__pycache__/
