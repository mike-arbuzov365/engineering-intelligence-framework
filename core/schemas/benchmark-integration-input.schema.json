{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mike-arbuzov365/engineering-intelligence-framework/core/schemas/benchmark-integration-input.schema.json",
  "title": "EIF benchmark integration runner input",
  "description": "Content-free integration evidence passed explicitly to a mode C/D benchmark runner. It contains provider states, versions, digests and capability names, never paths, prompts, commands or output.",
  "type": "object",
  "required": ["schema_version", "mode", "graphify"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "mode": {
      "type": "string",
      "enum": ["C_structural_navigation", "D_full_stack"]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "graphify": {
      "type": "object",
      "required": [
        "provider", "health_state", "freshness_state", "version",
        "artifact_digest", "target_source_digest", "available_capabilities"
      ],
      "properties": {
        "provider": { "const": "graphify" },
        "health_state": { "const": "healthy" },
        "freshness_state": { "const": "fresh" },
        "version": { "type": "string", "minLength": 1 },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target_source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "available_capabilities": {
          "type": "array",
          "items": { "type": "string", "enum": ["query", "path", "explain"] },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "rtk": {
      "type": "object",
      "required": ["provider", "health_state", "version", "registry_version"],
      "properties": {
        "provider": { "const": "rtk" },
        "health_state": { "const": "healthy" },
        "version": { "type": "string", "minLength": 1 },
        "registry_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "D_full_stack" } },
        "required": ["mode"]
      },
      "then": { "required": ["rtk"] }
    }
  ]
}
