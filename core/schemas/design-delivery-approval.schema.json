{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mike-arbuzov365/engineering-intelligence-framework/core/schemas/design-delivery-approval.schema.json",
  "title": "EIF graphic-design package and delivery approval",
  "description": "Local owner-gated state for EIF-managed package/final-delivery validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "package_allowed"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "const": "graphic-design" },
    "package_allowed": { "type": "boolean", "default": false },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "scope",
        "actions",
        "decided_at",
        "valid_until",
        "evidence_ref"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["package", "final_delivery"]
          }
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(https://[^\\s]+|[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "package_allowed": { "const": true } },
        "required": ["package_allowed"]
      },
      "then": { "required": ["decision"] }
    },
    {
      "if": {
        "properties": { "package_allowed": { "const": false } },
        "required": ["package_allowed"]
      },
      "then": { "not": { "required": ["decision"] } }
    }
  ]
}
