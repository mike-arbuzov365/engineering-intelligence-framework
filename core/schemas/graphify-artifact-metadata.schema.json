{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mike-arbuzov365/engineering-intelligence-framework/core/schemas/graphify-artifact-metadata.schema.json",
  "title": "EIF Graphify artifact metadata",
  "type": "object",
  "required": [
    "schema_version", "repo_id", "source_commit", "graphify_version",
    "manifest_hash", "scope_hash", "graph_sha256", "generated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "repo_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "graphify_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "scope_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "graph_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
