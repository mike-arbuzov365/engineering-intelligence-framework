{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EIF sequential packet launch and review records",
  "oneOf": [{"$ref": "#/$defs/launch"}, {"$ref": "#/$defs/review"}],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "revision": {"type": "string", "pattern": "^([0-9a-f]{40}|sha256:[0-9a-f]{64})$"},
    "short_text": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S"},
    "scope": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"$ref": "#/$defs/short_text"}
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "scope", "no_touch", "criteria"],
      "dependentRequired": {"attempt": ["base_revision"], "current_revision": ["attempt"]},
      "properties": {
        "goal": {"$ref": "#/$defs/short_text"},
        "scope": {"$ref": "#/$defs/scope"},
        "no_touch": {"$ref": "#/$defs/scope"},
        "base_revision": {"$ref": "#/$defs/revision"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 999999},
        "current_revision": {"$ref": "#/$defs/revision"},
        "model": {"$ref": "#/$defs/short_text"},
        "model_reason": {"$ref": "#/$defs/short_text"},
        "criteria": {
          "type": "object", "minProperties": 1, "maxProperties": 16,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/short_text"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance", "packet", "session", "attempt", "base_revision", "reviewed_revision", "decision", "criteria", "reason"],
      "properties": {
        "instance": {"$ref": "#/$defs/identifier"},
        "packet": {"$ref": "#/$defs/identifier"},
        "session": {"type": "string", "pattern": "^SESSION-[0-9]{3,12}$"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 999999},
        "base_revision": {"$ref": "#/$defs/revision"},
        "reviewed_revision": {"$ref": "#/$defs/revision"},
        "reviewed_contract": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "decision": {"enum": ["accepted", "changes_requested"]},
        "reason": {"$ref": "#/$defs/short_text"},
        "criteria": {
          "type": "object", "maxProperties": 16,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result", "evidence"],
            "properties": {
              "result": {"enum": ["pass", "fail", "not_run"]},
              "evidence": {"$ref": "#/$defs/short_text"}
            }
          }
        }
      }
    }
  }
}
