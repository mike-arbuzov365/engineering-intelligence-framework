{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-intelligence-framework.dev/schemas/project-locations.schema.json",
  "title": "EIF machine-local project locations",
  "description": "Gitignored mapping from stable logical project IDs to paths on one machine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locations"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "path"],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
