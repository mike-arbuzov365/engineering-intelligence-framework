{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-intelligence-framework.dev/schemas/project-registry.schema.json",
  "title": "EIF private workspace project registry",
  "description": "Committed logical project identities. Machine-specific paths belong in project-locations.yaml, never in this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "profile", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "status": {
            "type": "string",
            "enum": ["active", "detached"]
          },
          "required_exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact", "reason", "approved_by"],
              "properties": {
                "artifact": {
                  "type": "string",
                  "pattern": "^[a-z-]+/[A-Za-z0-9._/-]+$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "approved_by": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "default": []
          }
        }
      }
    }
  }
}
