{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mike-arbuzov365/engineering-intelligence-framework/core/schemas/skill-eval-manifest.schema.json",
  "title": "EIF bounded skill eval manifest",
  "description": "Визначає matched baseline/treatment plan із deterministic graders і explicit owner budget gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "eval_id",
    "skills",
    "modes",
    "execution_order",
    "max_model_runs",
    "owner_gate",
    "model",
    "graders"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "eval_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "contract_path", "scenario_ids"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "contract_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "scenario_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            }
          }
        }
      }
    },
    "modes": {
      "type": "array",
      "prefixItems": [
        { "const": "baseline" },
        { "const": "treatment" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "execution_order": { "const": "sequential" },
    "max_model_runs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "owner_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavioral_status",
        "hard_zero_cost_confirmed",
        "additional_paid_budget_usd",
        "provider",
        "model",
        "version",
        "rubric_judge",
        "usage_telemetry",
        "stop_on_unavailable_telemetry",
        "reason"
      ],
      "properties": {
        "behavioral_status": {
          "enum": ["approved", "deferred"]
        },
        "hard_zero_cost_confirmed": { "type": "boolean" },
        "additional_paid_budget_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 0
        },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "rubric_judge": {
          "enum": ["approved", "not_requested", "not_approved"]
        },
        "usage_telemetry": { "const": "required" },
        "stop_on_unavailable_telemetry": { "const": true },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "behavioral_status": { "const": "deferred" } },
            "required": ["behavioral_status"]
          },
          "then": {
            "properties": {
              "hard_zero_cost_confirmed": { "const": false },
              "provider": { "const": "not_approved" },
              "model": { "const": "not_approved" },
              "version": { "const": "not_approved" },
              "rubric_judge": { "const": "not_approved" }
            }
          }
        },
        {
          "if": {
            "properties": { "behavioral_status": { "const": "approved" } },
            "required": ["behavioral_status"]
          },
          "then": {
            "properties": {
              "hard_zero_cost_confirmed": { "const": true }
            },
            "not": {
              "anyOf": [
                { "properties": { "provider": { "const": "not_approved" } }, "required": ["provider"] },
                { "properties": { "model": { "const": "not_approved" } }, "required": ["model"] },
                { "properties": { "version": { "const": "not_approved" } }, "required": ["version"] }
              ]
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "version", "settings"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "settings": { "type": "object" }
      }
    },
    "graders": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "assertion"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "kind": { "const": "deterministic" },
          "assertion": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
