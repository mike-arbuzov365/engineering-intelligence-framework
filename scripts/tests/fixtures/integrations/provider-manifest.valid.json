{
  "schema_version": 1,
  "integration": "example-tool",
  "adapter_version": "1.0.0",
  "executable": "example-tool",
  "compatibility": {
    "version_command": ["example-tool", "--version"],
    "version_pattern": "example-tool ([0-9]+\\.[0-9]+\\.[0-9]+)",
    "min_inclusive": "1.2.0",
    "max_exclusive": "2.0.0",
    "tested_versions": ["1.2.3"]
  },
  "capabilities": [
    {
      "id": "behavioral-canary",
      "required_for_healthy": true,
      "description": "Executes a deterministic local canary."
    }
  ],
  "data_boundaries": ["local-only"],
  "default_mode": "local",
  "failure_modes": ["degrade", "fail-closed"],
  "artifact_policy": {
    "raw_output_committed": false,
    "telemetry_content_allowed": false
  }
}
