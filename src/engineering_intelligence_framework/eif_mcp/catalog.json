  {
    "name": "eif_brief",
    "description": "Route an explicit task kind using pinned skill metadata and bounded state.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_kind": {
          "enum": [
            "light",
            "structured",
            "idea",
            "prd",
            "packet_plan",
            "packet_run",
            "packet_review",
            "knowledge_search",
            "knowledge_ingest",
            "retro"
          ]
        }
      },
      "required": [
        "task_kind"
      ],
      "additionalProperties": false
