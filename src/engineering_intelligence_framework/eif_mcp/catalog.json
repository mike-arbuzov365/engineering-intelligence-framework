  {
    "name": "eif_artifact_get",
    "description": "List heading slugs or page one section of a named, hash-checked pinned artifact.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "playbook",
            "template",
            "rule"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12000,
          "default": 4000
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "eif_knowledge_search",
    "description": "Search contained knowledge with lifecycle filtering and explicit coverage.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "top": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "status": {
          "enum": [
            "validated",
            "draft",
            "superseded",
            "deprecated",
            "rejected"
          ]
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "eif_packet_status",
    "description": "Read explicit packet progress and the first dependency-ready session.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "packet": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
